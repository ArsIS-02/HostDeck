# Скопируйте в .env и задайте свой пароль (минимум 12 символов). Файл .env в git не попадает.
HOSTDECK_ADMIN_PASSWORD=
HOSTDECK_ADMIN_USER=admin
# IP обратного прокси (nginx/Caddy/Traefik), которому доверяем X-Forwarded-Proto
FORWARDED_ALLOW_IPS=127.0.0.1

# Необязательная синхронизация окон обслуживания с Zabbix.
# Предпочтительно задавать ZABBIX_TOKEN_FILE через защищённый mount, а не токен здесь.
ZABBIX_API=
ZABBIX_TOKEN=
ZABBIX_TOKEN_FILE=
ZABBIX_CA_FILE=
